# Copy this file to .env and adjust the values for your environment.
# The docker-compose setup reads DB_USERNAME and DB_PASSWORD for the API and
# uses DB_PASSWORD also as the MariaDB root password; the Spring Boot
# application reads the same variables (see
# api/src/main/resources/application.properties). Both are required - there are
# no hardcoded default credentials any more, so a missing value fails fast with
# an explicit message instead of silently using root/root.
#
# DB_USERNAME must stay "root" for the Docker Compose stack: the MariaDB
# container only creates the root account (from MARIADB_ROOT_PASSWORD), so any
# other name is never created and the API fails to authenticate. Running the
# API against your own database instead, any existing user works.
DB_USERNAME=root
DB_PASSWORD=changeme
DB_URL=jdbc:mariadb://localhost:3306/pe2
