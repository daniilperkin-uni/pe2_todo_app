{
    "name": "todo-frontend",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check build-only",
        "preview": "vite preview",
        "build-only": "vite build",
        "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "lint": "eslint . --fix --ignore-pattern .gitignore",
        "lint:ci": "eslint . --ignore-pattern .gitignore",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "test": "vitest run"
    },
    "dependencies": {
        "agnostic-vue": "^1.1.3",
        "file-saver": "^2.0.5",
        "vue": "^3.5.45",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@tsconfig/node24": "^24.0.6",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^24.5.2",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/test-utils": "^2.6.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^9.36.0",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^16.4.0",
        "jsdom": "^30.1.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.1",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.73.0",
        "vite": "^7.1.7",
        "vitest": "^5.1.1",
        "vue-eslint-parser": "^10.4.2",
        "vue-tsc": "^3.3.14"
    }
}
